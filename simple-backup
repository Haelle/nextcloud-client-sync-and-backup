#!/bin/bash
set -u
: "${BREVO_API_KEY}"
: "${MAIL_FROM}"
: "${MAIL_TO}"
: "${BACKUP_FILE}"
: "${BACKUP_ROOT}"

tar -czf $BACKUP_FILE -C $BACKUP_ROOT Nextcloud/

subject="Nextcloud $(uname -n) backup done"

curl -fsS -X POST https://api.brevo.com/v3/smtp/email \
  -H "api-key: $BREVO_API_KEY" -H "content-type: application/json" \
  -d "{\"sender\":{\"email\":\"$MAIL_FROM\"},\"to\":[{\"email\":\"$MAIL_TO\"}],\"subject\":\"$subject\",\"textContent\":\"$subject\"}"
